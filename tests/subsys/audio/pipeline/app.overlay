/*
 * RAM disk backing the ext2 fixture filesystem the file node suites need
 * (see wav_fixture.h). 512 sectors of 512 bytes = 256 KiB, which is well
 * above the ext2 minimum and leaves room for the fixture files.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/ {
	ramdisk0 {
		compatible = "zephyr,ram-disk";
		disk-name = "RAM";
		sector-size = <512>;
		sector-count = <512>;
	};
};
