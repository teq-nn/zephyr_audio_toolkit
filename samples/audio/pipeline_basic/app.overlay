/*
 * RAM disk holding the ext2 filesystem the sample formats at start-up, so the
 * file reader source has a real WAV file to play on native_sim.
 *
 * 512 sectors of 512 bytes = 256 KiB: comfortably above the ext2 minimum and
 * large enough for the generated track.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/ {
	ramdisk0 {
		compatible = "zephyr,ram-disk";
		disk-name = "RAM";
		sector-size = <512>;
		sector-count = <512>;
	};
};
