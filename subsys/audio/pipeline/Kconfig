menuconfig AUDIO_PIPELINE
	bool "Zephyr audio pipeline"
	select FILE_SYSTEM
	help
	  Enable the pull-based audio pipeline subsystem and helper nodes.

	  The file reader source and the file writer sink shipped with the
	  subsystem talk to the Zephyr filesystem API, so FILE_SYSTEM is
	  selected unconditionally. That only pulls in the dispatch layer -
	  the application still chooses a filesystem type (ext2, FAT,
	  littlefs, ...) and mounts it before opening the pipeline.

if AUDIO_PIPELINE

config AUDIO_PIPELINE_FRAME_SAMPLES
	int "Samples per frame (total across all channels)"
	default 128
	range 2 1024
	help
	  Size of the shared pipeline frame buffer, counted in TOTAL int32_t
	  samples across all channels - not per channel. Samples are
	  interleaved, so at 2 channels a value of 128 carries 64 sample pairs,
	  and AUDIO_PIPELINE_DEFINE() allocates exactly this many int32_t with
	  no channel multiplier anywhere.

	  Total rather than per channel because the channel count is not known
	  here: it is bound at run time by audio_pipeline_set_format() and owned
	  by the pipeline (manifest §4), so a per-channel figure could not be
	  turned into a buffer size at compile time without a second, static
	  channel-count symbol to disagree with the bound format.

	  Latency per iteration is therefore
	  frame_samples / (sample_rate_hz * channels): 128 total samples at
	  48 kHz stereo is 64 frames, i.e. ~1.33 ms.

	  Default 128 (512 bytes) is kept from the shipped behaviour: it is a
	  comfortable ~1.3 ms of stereo at 48 kHz and it stays a power of two
	  for every channel count in the v1 range. The upper bound of 1024
	  caps the static buffer at 4 KiB.

	  The minimum is 2, not 1: a total frame of 1 sample cannot hold one
	  interleaved sample set for the 2 channels the shipped file nodes
	  accept (their v1 range is 1..2), so it is a value no stereo pipeline
	  could ever use. 2 is the smallest frame that holds one full
	  interleaved sample set for every format those nodes can bind. Node
	  sets with more channels are covered at run time instead, where the
	  channel count is known: audio_pipeline_set_format() refuses a format
	  whose one interleaved sample set does not fit the frame buffer.

config AUDIO_PIPELINE_EVENT_QUEUE_DEPTH
	int "Event queue depth per pipeline"
	default 4
	range 1 32
	help
	  Number of audio_pipeline_event entries the per-pipeline message queue
	  can hold. The storage is allocated statically, either by
	  AUDIO_PIPELINE_DEFINE() or - for a zero-initialised instance - by the
	  subsystem itself. When the queue is full the newest event is dropped,
	  so the oldest ones (and with them the first error) always survive.

config AUDIO_PIPELINE_THREAD_PRIO
	int "Pipeline thread priority"
	default 5
	help
	  Priority assigned to the pipeline worker thread.

config AUDIO_PIPELINE_THREAD_STACK_SIZE
	int "Pipeline thread stack size"
	default 2048
	help
	  Stack size for the pipeline worker thread.

endif
